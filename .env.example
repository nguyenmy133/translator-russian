# ============================================
# GMAIL CONFIGURATION
# ============================================
# Email nhận file (email của bạn)
GMAIL_ADDRESS=your_email@gmail.com

# App Password (KHÔNG phải mật khẩu Gmail thông thường)
# Hướng dẫn tạo: https://myaccount.google.com/apppasswords
# Yêu cầu bật 2FA trước
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email gửi kết quả về (thường là email của bạn)
SENDER_EMAIL=your_email@gmail.com

# ============================================
# IMAP / SMTP SETTINGS (Gmail mặc định)
# ============================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ============================================
# APP SETTINGS
# ============================================
# Tần suất kiểm tra email mới (giây), mặc định 5 phút
POLL_INTERVAL_SECONDS=300

# Thư mục lưu file tạm
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# Database
DATABASE_URL=sqlite:///./translator.db

# Secret key cho session (đổi thành chuỗi random)
SECRET_KEY=change-this-to-a-random-secret-key-12345

# ============================================
# GEMINI API CONFIGURATION
# ============================================
# Đăng ký miễn phí tại https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# WHITELIST SENDERS
# ============================================
# Danh sách email được phép gửi file (cách nhau bởi dấu phẩy)
# Sử dụng "*" để cho phép tất cả các email (dùng khi kiểm thử/deploy)
ALLOWED_SENDERS=content@clawshorns.com,meinguyen133@gmail.com

# URL Frontend để cấu hình CORS bảo mật
FRONTEND_URL=https://russian-translatoz.xyz

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
